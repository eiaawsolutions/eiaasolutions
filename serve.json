{
  "public": ".",
  "cleanUrls": false,
  "trailingSlash": false,
  "directoryListing": false,
  "rewrites": [
    { "source": "/", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "**",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" },
        { "key": "Content-Security-Policy", "value": "base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" }
      ]
    },
    {
      "source": "**/*.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "**/*.@(jpg|jpeg|png|svg|webp|avif|woff2|css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "**/*.mp4",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=604800" }
      ]
    },
    {
      "source": "**/*.@(xml|txt|json)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "type": 301
    },
    {
      "source": "/full-stack-engineer.html",
      "destination": "/products.html",
      "type": 301
    },
    { "source": "/products", "destination": "/products.html", "type": 301 },
    { "source": "/privacy", "destination": "/privacy.html", "type": 301 },
    { "source": "/terms", "destination": "/terms.html", "type": 301 },
    { "source": "/favicon.ico", "destination": "/brand/shield.png", "type": 301 },

    { "source": "/node_modules/*", "destination": "/not-found", "type": 302 },
    { "source": "/docs/*", "destination": "/not-found", "type": 302 },
    { "source": "/.github/*", "destination": "/not-found", "type": 302 },
    { "source": "/.git/*", "destination": "/not-found", "type": 302 },
    { "source": "/.claude/*", "destination": "/not-found", "type": 302 },
    { "source": "/package.json", "destination": "/not-found", "type": 302 },
    { "source": "/package-lock.json", "destination": "/not-found", "type": 302 },
    { "source": "/railway.json", "destination": "/not-found", "type": 302 },
    { "source": "/serve.json", "destination": "/not-found", "type": 302 },
    { "source": "/README.md", "destination": "/not-found", "type": 302 },
    { "source": "/.gitignore", "destination": "/not-found", "type": 302 },
    { "source": "/.gitattributes", "destination": "/not-found", "type": 302 },
    { "source": "/.nojekyll", "destination": "/not-found", "type": 302 }
  ]
}
