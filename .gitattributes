# Default: normalise to LF in the repo, check out native on working tree.
* text=auto eol=lf

# Web assets — always LF (served as-is to browsers).
*.html   text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.json   text eol=lf
*.svg    text eol=lf
*.md     text eol=lf

# Windows-specific files keep CRLF (not used here, but safe to pin).
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# Binaries — never touch.
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.woff   binary
*.woff2  binary
